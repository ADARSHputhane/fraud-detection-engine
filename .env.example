# Copy to .env and adjust. Defaults match docker-compose.yml.
DATABASE_URL=postgresql+psycopg://fraud:fraud@localhost:5432/fraud
REDIS_URL=redis://localhost:6379/0
STREAM_NAME=events:incoming
STREAM_MAXLEN=100000
CONSUMER_GROUP=scorers
WORKER_BATCH_SIZE=100
DEADLETTER_STREAM=events:deadletter
FEATURE_PREFIX=fe
